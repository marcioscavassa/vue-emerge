{
  "compilerOptions": {
    "skipLibCheck": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "vue-emerge": ["./src/index.ts"]
    }
  },
  "include": ["vite.config.ts", "vitest.config.ts", "tests/**/*.ts", "src/**/*.ts", "src/**/*.vue", "playground/**/*"]
}
