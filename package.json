{
  "name": "vue-emerge",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "A simple Vue component to animate elements when they enter the viewport on scroll.",
  "keywords": [
    "vue",
    "vue3",
    "vuejs",
    "vue-component",
    "component",
    "emerge",
    "animation",
    "animate-on-scroll",
    "aos",
    "scroll",
    "scrolling",
    "on-scroll",
    "scroll-animation",
    "scroll-reveal",
    "entrance-animation",
    "appear-on-scroll",
    "intersection-observer",
    "viewport",
    "composable",
    "typescript",
    "motion",
    "transition",
    "effects"
  ],
  "author": "Marcio Scavassa <npm@marcioscavassa.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/marcioscavassa/vue-emerge.git"
  },
  "main": "./dist/vue-emerge.umd.js",
  "module": "./dist/vue-emerge.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-emerge.es.js",
      "require": "./dist/vue-emerge.umd.js"
    }
  },
  "files": [
    "dist/**"
  ],
  "scripts": {
    "dev": "vite playground",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "vue": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.5.1",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/browser-playwright": "^4.1.12",
    "@vue/test-utils": "^2.6.0",
    "happy-dom": "^21.0.4",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.12",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  }
}
