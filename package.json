{
  "name": "vue-emerge",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "description": "A simple Vue component to animate elements when they enter the viewport on scroll.",
  "keywords": [
    "vue",
    "vue3",
    "vuejs",
    "vue-component",
    "component",
    "emerge",
    "animation",
    "animate-on-scroll",
    "aos",
    "scroll",
    "scrolling",
    "on-scroll",
    "scroll-animation",
    "scroll-reveal",
    "entrance-animation",
    "appear-on-scroll",
    "intersection-observer",
    "viewport",
    "composable",
    "typescript",
    "motion",
    "transition",
    "effects"
  ],
  "author": "Marcio Scavassa <npm@marcioscavassa.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/marcioscavassa/vue-emerge.git"
  },
  "main": "./dist/vue-emerge.umd.js",
  "module": "./dist/vue-emerge.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-emerge.es.js",
      "require": "./dist/vue-emerge.umd.js"
    }
  },
  "files": [
    "dist/**"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "vue": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.5.1",
    "@vitejs/plugin-vue": "^5.0.5",
    "typescript": "^5.2.2",
    "vite": "^5.3.1",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vite-plugin-dts": "^4.5.4",
    "vue": "^3.4.29",
    "vue-tsc": "^2.0.21"
  }
}
