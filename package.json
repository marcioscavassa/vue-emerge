{
  "name": "vue-emerge",
  "version": "0.3.0",
  "private": false,
  "type": "module",
  "description": "A lightweight Vue 3 component, directive and composable to animate elements when they enter the viewport on scroll.",
  "keywords": [
    "vue",
    "vue3",
    "vuejs",
    "vue-component",
    "component",
    "emerge",
    "animation",
    "animate-on-scroll",
    "aos",
    "scroll",
    "scrolling",
    "on-scroll",
    "scroll-animation",
    "scroll-reveal",
    "entrance-animation",
    "appear-on-scroll",
    "intersection-observer",
    "viewport",
    "composable",
    "typescript",
    "motion",
    "transition",
    "effects",
    "directive",
    "prefers-reduced-motion"
  ],
  "author": "Marcio Scavassa <npm@marcioscavassa.dev>",
  "license": "MIT",
  "homepage": "https://github.com/marcioscavassa/vue-emerge#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/marcioscavassa/vue-emerge.git"
  },
  "bugs": {
    "url": "https://github.com/marcioscavassa/vue-emerge/issues"
  },
  "main": "./dist/vue-emerge.umd.js",
  "module": "./dist/vue-emerge.es.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/vue-emerge.umd.js",
  "jsdelivr": "./dist/vue-emerge.umd.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-emerge.es.js",
      "require": "./dist/vue-emerge.umd.cjs",
      "default": "./dist/vue-emerge.es.js"
    },
    "./no-css": {
      "types": "./dist/no-css.d.ts",
      "import": "./dist/no-css.es.js",
      "default": "./dist/no-css.es.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/vue-emerge.es.js",
    "./dist/vue-emerge.umd.js",
    "*.css"
  ],
  "files": [
    "dist/**"
  ],
  "scripts": {
    "dev": "vite playground",
    "build": "vite build && vite build --mode no-css",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "size-limit"
  },
  "peerDependencies": {
    "vue": "^3.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@size-limit/file": "^14.3.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/browser-playwright": "^5.1.0",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "size-limit": "^14.3.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-css-injected-by-js": "^5.0.3",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  },
  "size-limit": [
    {
      "name": "ES build",
      "path": "dist/vue-emerge.es.js",
      "limit": "5 kB"
    },
    {
      "name": "UMD build",
      "path": "dist/vue-emerge.umd.js",
      "limit": "5 kB"
    },
    {
      "name": "no-css build",
      "path": "dist/no-css.es.js",
      "limit": "4.5 kB"
    }
  ]
}
